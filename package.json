{
  "name": "handbells-used-chart",
  "version": "2.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Generate a Handbells Used chart for MuseScore handbell scores",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "npm run test:fast && npm run test:extension && npm run test:gui",
    "test:fast": "node --test \"test/unit/**/*.test.js\" \"test/e2e/**/*.test.js\"",
    "test:fast:coverage": "node -e \"require('fs').mkdirSync('coverage/fast',{recursive:true})\" && node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"handbells-used-chart/mutate.js\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/fast/lcov.info \"test/unit/**/*.test.js\" \"test/e2e/**/*.test.js\"",
    "test:extension": "node --test --test-concurrency=1 \"test/extension/**/*.test.js\"",
    "coverage:extension": "node test/extension/coverage-report.js",
    "chart": "node tools/chart-cli.js",
    "bundle": "node tools/bundle.js",
    "lint": "node tools/lint.js",
    "test:gui": "node --test --test-concurrency=1 \"test/gui/**/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
